{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS — persönlicher, tool-nutzender KI-Assistent",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
