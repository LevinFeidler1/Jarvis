    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
