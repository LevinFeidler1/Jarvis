{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS — persönlicher, tool-nutzender KI-Assistent",
  "type": "module",
  "engines": {
    "node": ">=22.5 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "setup:secrets": "tsx scripts/generate-secrets.ts",
    "vercel-build": "npm run typecheck"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@vercel/functions": "^3.9.9",
    "dotenv": "^18.0.5",
    "fastify": "^5.12.5",
    "imapflow": "^2.1.2",
    "mailparser": "^3.9.32",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/web-push": "^3.6.4",
    "smtp-server": "^3.19.16",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
