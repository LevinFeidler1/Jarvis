# ─── JARVIS Konfiguration ───────────────────────────────────────────────
# Lokal: nach .env kopieren. Auf Vercel: unter Settings → Environment Variables.
# Sichere Zufallswerte erzeugen: npm run setup:secrets
# NIEMALS .env committen.

# Claude API (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Nur für benutzerbezogene Keys (sk-ant-usr-…) ohne Workspace: Workspace-ID (wrkspc_…)
ANTHROPIC_WORKSPACE_ID=
# Optional: anderes Modell wählen
ANTHROPIC_MODEL=claude-opus-5-5

# Zugangstoken für die Web-UI (mind. 32 Zeichen)
JARVIS_ACCESS_TOKEN=
# 32-Byte-Schlüssel (Base64) für die Verschlüsselung von OAuth-Tokens
JARVIS_ENCRYPTION_KEY=

# Datenbank
# Leer = lokales PGlite (eingebettetes Postgres, Daten in JARVIS_DB_PATH).
# Auf Vercel Pflicht: Neon-Connection-String (wird von der Neon-Integration gesetzt).
DATABASE_URL=
JARVIS_DB_PATH=./data/pglite

# Öffentliche URL (OAuth-Redirects + Origin-Prüfung). Auf Vercel: https://<projekt>.vercel.app
JARVIS_PUBLIC_URL=http://localhost:3000
# Schützt /api/cron/tick (Vercel Cron sendet ihn als Bearer-Token)
CRON_SECRET=

# Lokaler Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3000

# Persönliches
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LANGUAGE=de
JARVIS_USER_NAME=

# Agent
JARVIS_MAX_AGENT_STEPS=12
JARVIS_CONFIRMATION_TTL_MINUTES=30
# Websuche der Claude API (true/false)
JARVIS_WEB_SEARCH=true
# Proaktive Mail-Hinweise: kleines Modell und max. geprüfte Mails pro Tag (Kostenbremse)
JARVIS_TRIAGE_MODEL=claude-haiku-4-5
JARVIS_TRIAGE_DAILY_LIMIT=150
# Browser-Agent: auto (Vercel: eigene Funktion api/browser.ts; lokal: JARVIS_CHROMIUM_PATH), off, local, remote
JARVIS_BROWSER=auto
# Optional: eigener Browser-Worker (npm run browser-worker hinter einem Tunnel)
JARVIS_BROWSER_URL=
# Lokal: Pfad zu Chrome/Chromium
JARVIS_CHROMIUM_PATH=
JARVIS_BROWSER_MAX_STEPS=25
JARVIS_BROWSER_TASK_MINUTES=15
# Dateien: max. Größe pro Datei und Quote für Dateien in der Datenbank (ohne Google Drive)
JARVIS_MAX_FILE_MB=20
JARVIS_DB_FILE_QUOTA_MB=150
# Lange Unterhaltungen ab so vielen Eingabe-Tokens serverseitig zusammenfassen (min. 50000)
JARVIS_COMPACT_AT_TOKENS=60000

# Google (Gmail, Calendar, Contacts, Drive) — siehe docs/SETUP_GOOGLE.md
# Optional: ganzes Google Drive lesend durchsuchen (zusätzlicher Scope drive.readonly)
JARVIS_DRIVE_READ_ALL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
