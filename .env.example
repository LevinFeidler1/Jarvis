# ─── JARVIS Konfiguration ───────────────────────────────────────────────
# Lokal: nach .env kopieren. Auf Vercel: unter Settings → Environment Variables.
# Sichere Zufallswerte erzeugen: npm run setup:secrets
# NIEMALS .env committen.

# Claude API (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Optional: anderes Modell wählen
ANTHROPIC_MODEL=claude-opus-5-5

# Zugangstoken für die Web-UI (mind. 32 Zeichen)
JARVIS_ACCESS_TOKEN=
# 32-Byte-Schlüssel (Base64) für die Verschlüsselung von OAuth-Tokens
JARVIS_ENCRYPTION_KEY=

# Datenbank
# Leer = lokales PGlite (eingebettetes Postgres, Daten in JARVIS_DB_PATH).
# Auf Vercel Pflicht: Neon-Connection-String (wird von der Neon-Integration gesetzt).
DATABASE_URL=
JARVIS_DB_PATH=./data/pglite

# Öffentliche URL (OAuth-Redirects + Origin-Prüfung). Auf Vercel: https://<projekt>.vercel.app
JARVIS_PUBLIC_URL=http://localhost:3000
# Schützt /api/cron/tick (Vercel Cron sendet ihn als Bearer-Token)
CRON_SECRET=

# Lokaler Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3000

# Persönliches
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LANGUAGE=de
JARVIS_USER_NAME=

# Agent
JARVIS_MAX_AGENT_STEPS=12
JARVIS_CONFIRMATION_TTL_MINUTES=30
# Websuche der Claude API (true/false)
JARVIS_WEB_SEARCH=true

# Google (Gmail, Calendar, Contacts) — siehe docs/SETUP_GOOGLE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
