# ─── JARVIS Konfiguration ───────────────────────────────────────────────
# Kopiere diese Datei nach .env und fülle die Werte aus.
# Sichere Zufallswerte erzeugen: npm run setup:secrets
# NIEMALS .env committen.

# Claude API (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=
# Optional: anderes Modell wählen
ANTHROPIC_MODEL=claude-opus-5-5

# Zugangstoken für die Web-UI (mind. 32 Zeichen)
JARVIS_ACCESS_TOKEN=
# 32-Byte-Schlüssel (Base64) für die Verschlüsselung von OAuth-Tokens
JARVIS_ENCRYPTION_KEY=

# Server
JARVIS_HOST=127.0.0.1
JARVIS_PORT=3000
# Öffentliche URL (für OAuth-Redirects und Origin-Prüfung)
JARVIS_PUBLIC_URL=http://localhost:3000
JARVIS_DB_PATH=./data/jarvis.db
JARVIS_TIMEZONE=Europe/Berlin
JARVIS_LANGUAGE=de
JARVIS_USER_NAME=

# Agent
JARVIS_MAX_AGENT_STEPS=12
JARVIS_CONFIRMATION_TTL_MINUTES=30

# Google (Gmail, Calendar, Contacts) — siehe docs/SETUP_GOOGLE.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
